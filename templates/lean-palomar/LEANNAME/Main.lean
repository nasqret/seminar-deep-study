namespace {{LEAN_NAME}}

variable {K : Type*} [Field K]

/-- Example: `R` has only simple roots in characteristic zero. The multipliers come from the
extended gcd of `R` and `R'` (found by a CAS); `linear_combination` checks `1 = a·R + b·R'`. -/
theorem R_simple [CharZero K] {r : K} (h : R r = 0) (h' : 4 * r ^ 3 - 12 * r = 0) : False := by
  unfold R at h
  have key : (1 : K) = 0 := by
    linear_combination (1/12*r^2 - 1/3) * h + (-1/48*r^3 + 7/48*r) * h'
  norm_num at key

end {{LEAN_NAME}}
