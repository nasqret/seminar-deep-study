module

public import Mathlib.Tactic.LinearCombination
public import Mathlib.Tactic.Ring
public import Mathlib.Tactic.NormNum

@[expose] public section

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

/-!
# Algebraic certificates (generated)

**Do not edit by hand.** Generated by `cert2lean.py` from `sample.out`.
Each identity was *found* by a computer algebra system and is *checked* here by
`linear_combination` or `ring`: a wrong certificate fails to compile.
-/

namespace Demo.Cert

variable {K : Type*} [Field K] [CharZero K]

/-- R(r) = r^4 - 6r^2 - 3 has only simple roots (extended gcd: 1 = a R + b R'). -/
theorem R_simple {r : K}
    (h : r^4 - 6*r^2 - 3 = 0)
    (h' : 4*r^3 - 12*r = 0) :
    False := by
  have key : (1 : K) = 0 := by
    linear_combination (1/12*r^2 - 1/3) * h + (-1/48*r^3 + 7/48*r) * h'
  norm_num at key

/-- If x = y then x^2 = y^2 (the goal lies in the ideal generated by x - y). -/
theorem sq_eq_of_eq {x y : K}
    (h : x - y = 0) :
    x^2 - y^2 = 0 := by
  linear_combination (x + y) * h

/-- The restriction of a form to a line, expanded (a ring identity). -/
theorem binomial_expand (a b : K) :
    (a + b)^3 =
      a^3 + 3*a^2*b + 3*a*b^2 + b^3 := by
  ring

end Demo.Cert
